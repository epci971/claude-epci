# OpenClaw Pipeline — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# Set permissions: chmod 600 .env

# === Required: Notion API ===
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Required: GitHub ===
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Required: Telegram Notifications ===
TELEGRAM_BOT_TOKEN=123456789:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHAT_ID=-100XXXXXXXXXX

# === Optional: Logging ===
# Directory for pipeline log files (default: ./logs)
LOG_DIR=./logs

# Enable debug output (set to 1 to enable, empty to disable)
DEBUG=
